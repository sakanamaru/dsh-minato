{
  "name": "dsh-minato-bridge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only status bridge for DeepSeek Harness: writes a small JSON snapshot (counts and states only) that external tools such as dsht read.",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "status"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
