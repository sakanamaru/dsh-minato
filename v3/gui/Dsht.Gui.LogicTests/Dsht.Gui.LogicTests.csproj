<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GUI 呈现层逻辑测试（**不依赖 Avalonia**：只编译 Markers/ 下的纯解析器）——
    这样它能在无图形环境（CI、Linux 容器）里跑，和 v2.x 的 guilogictests 是一个思路。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dsht-gui-logictests</AssemblyName>
    <RootNamespace>Dsht.Gui.LogicTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Dsht.Gui.Avalonia\Markers\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Dsht.Domain\Services\MarkerText.cs" Link="MarkerText.cs" />
    <!-- ★ 2026-10-13：package.json 的字段判定（`repository` 对象形态取 `.url`）搬到了 Domain 层 ——
         CLI 与 GUI 单测要**同一份**判定（各写一遍就会出现两个答案）。本工程不引用 GUI 程序集，
         只编译 Markers/*.cs 加显式列出的 Domain 源文件，所以这里显式加进来（同上一个 MarkerText.cs）。 -->
    <Compile Include="..\..\src\Dsht.Domain\Services\PackageJsonFields.cs" Link="PackageJsonFields.cs" />
  </ItemGroup>
</Project>
