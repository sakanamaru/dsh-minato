<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GUI 呈现层逻辑测试（**不依赖 Avalonia**：只编译 Markers/ 下的纯解析器）——
    这样它能在无图形环境（CI、Linux 容器）里跑，和 v2.x 的 guilogictests 是一个思路。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dsht-gui-logictests</AssemblyName>
    <RootNamespace>Dsht.Gui.LogicTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Dsht.Gui.Avalonia\Markers\*.cs" />
    <!-- ★ 2026-10-26 视觉规范化：设计 token 表**只有一份**（Design/DesignTokens.cs）——
         它刻意不含任何 Avalonia 类型（纯 string/double/int + 自带色math）⇒ 本工程能直接编译它，
         于是"5 语义色 × 明暗两套都在 / 间距是 4 的倍数 / 字号 ≤3 档 / 动效 ≤200ms / 状态灯对比度"
         这些断言能在**无图形环境**里直接读真值 ✓（✗ 不靠正则去猜源码 ✗ 源码扫描只用于"散落 hex"）。 -->
    <Compile Include="..\Dsht.Gui.Avalonia\Design\DesignTokens.cs" Link="DesignTokens.cs" />
    <!-- ★ 2026-10-30（W2 · task-5）：CliRunner 是**纯 System.Diagnostics**（零 Avalonia 类型）⇒
         它能被本工程直接编译，于是"stderr 逐行前缀 / 超时分档 / 失败分类 / 缓存键与容量"这些
         纯逻辑可以在无图形环境里断言（✗ 不靠正则猜源码 ✗）。-->
    <Compile Include="..\Dsht.Gui.Avalonia\Services\CliRunner.cs" Link="CliRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Dsht.Domain\Services\MarkerText.cs" Link="MarkerText.cs" />
    <!-- ★ 2026-10-13：package.json 的字段判定（`repository` 对象形态取 `.url`）搬到了 Domain 层 ——
         CLI 与 GUI 单测要**同一份**判定（各写一遍就会出现两个答案）。本工程不引用 GUI 程序集，
         只编译 Markers/*.cs 加显式列出的 Domain 源文件，所以这里显式加进来（同上一个 MarkerText.cs）。 -->
    <Compile Include="..\..\src\Dsht.Domain\Services\PackageJsonFields.cs" Link="PackageJsonFields.cs" />
  </ItemGroup>
</Project>
