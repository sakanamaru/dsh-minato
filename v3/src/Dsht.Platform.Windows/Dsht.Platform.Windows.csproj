<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dsht.Domain\Dsht.Domain.csproj" />
    <!-- S2 + B-05: 共享源目录整体链接 —— 两个平台项目编译同一份（源文件放在 ..\Dsht.Platform.Shared\） -->
    <Compile Include="..\Dsht.Platform.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>